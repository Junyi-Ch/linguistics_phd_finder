---
import Base from '../../layouts/Base.astro';
import faculty from '../../data/faculty.json';
import programs from '../../data/programs.json';
import tax from '../../data/taxonomy.json';
import { REPO_URL } from '../../lib/site';
import { relatedFor, coauthorsFor, openalexFor, familyFor } from '../../lib/network';
import { DIMS, type Faculty, type Program, type Taxonomy } from '../../lib/data';
export function getStaticPaths() { return (faculty as Faculty[]).map((f) => ({ params: { slug: f.id }, props: { f } })); }
const { f } = Astro.props as { f: Faculty };
const base = import.meta.env.BASE_URL;
const T = tax as unknown as Taxonomy;
const p = (programs as Program[]).find((x) => x.slug === f.u);
const rel = relatedFor(f.id).slice(0, 8);
const co = coauthorsFor(f.id);
const oa = openalexFor(f.id);
const fam = familyFor(f.id);
// main focus: the starred labels, subfield first
const focus = DIMS.flatMap((d) => (f.labels[d] || []).filter((l) => l.p).map((l) => ({ d, c: l.c }))).slice(0, 5);
const hasLabels = DIMS.some((d) => (f.labels[d] || []).length > 0);
const treeN = fam ? fam.advisors.length + fam.students.length + fam.siblings.length : 0;
const onSite = (a: any) => 'f' in a && a.f;
const students = fam ? fam.students.slice().sort((a: any, b: any) => Number(!!onSite(b)) - Number(!!onSite(a))) : [];
const tabs = [
  rel.length ? { k: 'similar', i18n: 'related_h', label: 'Similar research', n: rel.length } : null,
  treeN ? { k: 'tree', i18n: 'tree_h', label: 'Academic tree', n: treeN } : null,
  co.length ? { k: 'coauthors', i18n: 'net_mode_co', label: 'Co-authors', n: co.length } : null,
].filter(Boolean) as { k: string; i18n: string; label: string; n: number }[];
const issue = `${REPO_URL}/issues/new?title=${encodeURIComponent('Data correction: ' + f.name + ' (' + (p?.short || f.u) + ')')}&body=${encodeURIComponent('Page: ' + base + 'faculty/' + f.id + '/\n\nWhat is wrong:\n')}`;
---
<Base title={f.name} description={`${f.name}, ${f.rank}, ${f.dept}, ${p?.name || ''}. ${f.summary}`}>
  <article class="person">
    <p class="small crumbs"><a href={`${base}faculty/`} data-i18n="dir_h1">Faculty</a> › {p && <a href={`${base}programs/${p.slug}/`}>{p.short || p.name}</a>}</p>

    <header class="p-head">
      <h1>{f.name}</h1>
      <p class="p-role">{f.rank === 'Faculty' ? <span data-i18n="rank_fac">Rank not listed</span> : f.title}</p>
      <p class="p-where">{p && <a href={`${base}programs/${p.slug}/`}>{p.name}</a>}<span class="muted"> · {f.dept}</span></p>
      {fam?.phd && <p class="p-phd muted"><span data-i18n="fam_phd">PhD:</span> {fam.phd.inst}{fam.phd.year ? `, ${fam.phd.year}` : ''}</p>}
    </header>

    {f.summary && <p class="p-summary"><span data-lang-only="en">{f.summary}</span><span data-lang-only="zh">{f.summary_zh || f.summary}</span></p>}

    {focus.length > 0 && <div class="chips p-focus">{focus.map((x) => <span class="chip" data-dim={x.d}><span data-lang-only="en">{T.dimensions[x.d].labels_short[x.c]}</span><span data-lang-only="zh">{T.dimensions[x.d].labels_short_zh[x.c]}</span></span>)}</div>}

    <div class="p-actions">
      <button type="button" class="btn primary save-btn" data-save={f.id} data-i18n="save">Save</button>
      {f.site && <a class="btn" href={f.site} target="_blank" rel="noreferrer" data-i18n="personal_site">Personal site</a>}
      {f.profile && <a class="btn" href={f.profile} target="_blank" rel="noreferrer" data-i18n="profile">Department profile</a>}
      {oa && <a class="btn" href={`https://openalex.org/authors/${oa}`} target="_blank" rel="noreferrer" data-i18n="oa_short">Publications</a>}
      {f.scholar && <a class="btn" href={f.scholar} target="_blank" rel="noreferrer" data-i18n="scholar">Google Scholar</a>}
    </div>

    {tabs.length > 0 && <section class="p-conn" aria-label="Connections">
      <div class="p-tabs" role="tablist">
        {tabs.map((t, i) => <button type="button" role="tab" id={`tab-${t.k}`} aria-controls={`panel-${t.k}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab={t.k}><span data-i18n={t.i18n}>{t.label}</span> <span class="n">{t.n}</span></button>)}
      </div>

      {rel.length > 0 && <div class="p-panel" role="tabpanel" id="panel-similar" aria-labelledby="tab-similar" data-panel="similar">
        <ul class="plist">{rel.map((r) => <li><a href={`${base}faculty/${r.f.id}/`}>{r.f.name}</a><span class="muted">{r.p?.short || r.f.u}</span></li>)}</ul>
        <p class="small p-more"><a href={`${base}network/?p=${f.id}`} data-i18n="related_map">See on the network map</a> →</p>
      </div>}

      {treeN > 0 && fam && <div class="p-panel" role="tabpanel" id="panel-tree" aria-labelledby="tab-tree" data-panel="tree" hidden>
        <div class="tree-cols">
          {fam.advisors.length > 0 && <div><h2 class="tree-h" data-i18n="fam_advisor">PhD advisor</h2><ul class="plist one">{fam.advisors.map((a: any) => onSite(a) ? <li><a href={`${base}faculty/${a.f.id}/`}>{a.f.name}</a><span class="muted">{a.p?.short || a.f.u}</span></li> : <li><span class="off">{a.name}</span></li>)}</ul></div>}
          {students.length > 0 && <div><h2 class="tree-h" data-i18n="tree_students">PhD students</h2><ul class="plist one">{students.slice(0, 10).map((a: any) => onSite(a) ? <li><a href={`${base}faculty/${a.f.id}/`}>{a.f.name}</a><span class="muted">{a.p?.short || a.f.u}</span></li> : <li><span class="off">{a.name}</span></li>)}</ul>{students.length > 10 && <p class="small muted" style="margin-top:6px"><span data-lang-only="en">and {students.length - 10} more</span><span data-lang-only="zh">另有 {students.length - 10} 位</span></p>}</div>}
          {fam.siblings.length > 0 && <div><h2 class="tree-h" data-i18n="tree_siblings">Share an advisor</h2><ul class="plist one">{fam.siblings.map((c: any) => <li><a href={`${base}faculty/${c.f.id}/`}>{c.f.name}</a><span class="muted">{c.p?.short || c.f.u}</span></li>)}</ul></div>}
        </div>
        <p class="small muted p-note"><span data-i18n="tree_note">Names in grey are not on this site. From Academic Family Tree and Wikidata.</span> <a href={`${base}network/?p=${f.id}&lines=adv`} data-i18n="tree_map">See the academic tree on the network map</a> →</p>
      </div>}

      {co.length > 0 && <div class="p-panel" role="tabpanel" id="panel-coauthors" aria-labelledby="tab-coauthors" data-panel="coauthors" hidden>
        <ul class="plist">{co.slice(0, 12).map((c) => <li><a href={`${base}faculty/${c.f.id}/`}>{c.f.name}</a><span class="muted">{c.p?.short || c.f.u} · <span data-lang-only="en">{c.n} {c.n === 1 ? 'paper' : 'papers'}</span><span data-lang-only="zh">{c.n} 篇</span></span></li>)}</ul>
        <p class="small p-more"><a href={`${base}network/?p=${f.id}&lines=co`} data-i18n="co_map">See co-authors on the network map</a> →</p>
      </div>}
    </section>}

    {(hasLabels || f.areas.length > 0) && <details class="p-more-info">
      <summary data-i18n="all_labels">All research labels</summary>
      {DIMS.map((d) => (f.labels[d] || []).length > 0 && (
        <div class="lab-row"><div class="lab-h"><span data-lang-only="en">{T.dimensions[d].label}</span><span data-lang-only="zh">{T.dimensions[d].label_zh}</span></div>
          <div class="chips">{(f.labels[d] || []).map((l) => <span class="chip" data-dim={d} title={T.dimensions[d].labels[l.c]}><span data-lang-only="en">{T.dimensions[d].labels_short[l.c]}</span><span data-lang-only="zh">{T.dimensions[d].labels_short_zh[l.c]}</span></span>)}</div></div>
      ))}
      {f.areas.length > 0 && <div class="lab-row"><div class="lab-h" data-i18n="research_areas">Research areas (from the department)</div><div class="chips">{f.areas.map((a) => <span class="chip">{a}</span>)}</div></div>}
      <p class="small muted" style="margin-top:12px" data-i18n="labels_note2">Labels are generated automatically from public profiles and may be incomplete.</p>
    </details>}

    <p class="small p-report"><a href={issue} target="_blank" rel="noreferrer" data-i18n="report">Report an error</a></p>
  </article>

  <style is:global>
    .person { max-width: 820px; }
    .crumbs { color: var(--ink-3); }
    .p-head { margin-top: 18px; }
    .p-head h1 { font-size: clamp(2rem, 1.4rem + 2vw, 2.9rem); line-height: 1.05; }
    .p-role { margin-top: 10px; color: var(--ink-2); }
    .p-where { margin-top: 2px; }
    .p-phd { margin-top: 2px; font-size: 0.9rem; }
    .p-summary { margin-top: 22px; font-size: 1.2rem; line-height: 1.5; color: var(--ink); max-width: 46ch; }
    .p-focus { margin-top: 16px; }
    .p-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
    .p-conn { margin-top: 40px; }
    .p-tabs { display: flex; flex-wrap: wrap; gap: 4px; border-bottom: 1px solid var(--line); }
    .p-tabs button { font: inherit; font-weight: 600; font-size: 0.95rem; color: var(--ink-3); background: none; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px; padding: 10px 14px; cursor: pointer; min-height: 44px; }
    .p-tabs button:hover { color: var(--ink); }
    .p-tabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--action); }
    .p-tabs .n { font-weight: 500; color: var(--ink-3); font-size: 0.85em; }
    .p-panel { padding-top: 18px; }
    .plist { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px 24px; }
    .plist.one { grid-template-columns: 1fr; gap: 8px; }
    .plist li { display: grid; gap: 1px; }
    .plist a { font-weight: 600; color: var(--ink); text-decoration: none; }
    .plist a:hover { color: var(--action-text); }
    .plist .muted { font-size: 0.875rem; }
    .plist .off { color: var(--ink-3); }
    .tree-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px 28px; }
    .tree-h { font-size: 0.8125rem; font-weight: 600; color: var(--ink-3); margin: 0 0 8px; }
    .p-more, .p-note { margin-top: 16px; }
    .p-more-info { margin-top: 36px; border-top: 1px solid var(--line); padding-top: 14px; }
    .p-more-info summary { cursor: pointer; font-weight: 600; color: var(--ink-2); width: max-content; }
    .lab-row { margin-top: 14px; }
    .lab-h { font-size: 0.8125rem; font-weight: 600; color: var(--ink-3); margin-bottom: 6px; }
    .p-report { margin-top: 28px; }
  </style>
  <script>
    import { bindSaveButtons } from '../../lib/ui';
    import { has } from '../../lib/shortlist';
    import { t } from '../../lib/i18n';
    document.querySelectorAll<HTMLButtonElement>('.save-btn').forEach((b) => { const on = has(b.dataset.save!); b.setAttribute('aria-pressed', String(on)); b.textContent = on ? t('saved') : t('save'); });
    bindSaveButtons(document);
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.p-tabs [data-tab]'));
    const show = (k: string) => {
      if (!tabs.some((b) => b.dataset.tab === k)) return;
      tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === k)));
      document.querySelectorAll<HTMLElement>('.p-panel').forEach((p) => { p.hidden = p.dataset.panel !== k; });
    };
    tabs.forEach((b) => b.addEventListener('click', () => { show(b.dataset.tab!); history.replaceState(null, '', '#' + b.dataset.tab); }));
    const h = location.hash.slice(1); if (h) show(h);
  </script>
</Base>
