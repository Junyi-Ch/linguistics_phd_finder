---
import Base from '../../layouts/Base.astro';
import faculty from '../../data/faculty.json';
import programs from '../../data/programs.json';
import tax from '../../data/taxonomy.json';
import { REPO_URL } from '../../lib/site';
import { relatedFor, coauthorsFor, openalexFor, familyFor } from '../../lib/network';
import { DIMS, initials, type Faculty, type Program, type Taxonomy, avatar } from '../../lib/data';
export function getStaticPaths() { return (faculty as Faculty[]).map((f) => ({ params: { slug: f.id }, props: { f } })); }
const { f } = Astro.props as { f: Faculty };
const base = import.meta.env.BASE_URL;
const T = tax as unknown as Taxonomy;
const p = (programs as Program[]).find((x) => x.slug === f.u);
const rel = relatedFor(f.id).slice(0, 6);
const co = coauthorsFor(f.id);
const oa = openalexFor(f.id);
const fam = familyFor(f.id);
const issue = `${REPO_URL}/issues/new?title=${encodeURIComponent('Data correction: ' + f.name + ' (' + (p?.short || f.u) + ')')}&body=${encodeURIComponent('Page: ' + base + 'faculty/' + f.id + '/\n\nWhat is wrong:\n')}`;
---
<Base title={f.name} description={`${f.name}, ${f.rank}, ${f.dept}, ${p?.name || ''}. ${f.summary}`}>
  <p class="small"><a href={`${base}faculty/`} data-i18n="dir_h1">Faculty</a> › {p && <a href={`${base}programs/${p.slug}/`}>{p.name}</a>}</p>
  <div class="identity" style="display:flex;gap:20px;align-items:flex-start;margin-top:14px">
    <Fragment set:html={avatar(f as any, true)} />
    <div>
      <div class="small muted">{f.rank === "Faculty" ? "Rank not listed" : f.title}</div>
      <h1 style="font-size:clamp(1.7rem,1.2rem+1.6vw,2.4rem)">{f.name}</h1>
      <div class="muted" style="margin-top:6px">{p && <a href={`${base}programs/${p.slug}/`}>{p.name}</a>} · {f.dept}</div>
      {fam?.phd && <div class="small muted" style="margin-top:6px"><span data-i18n="fam_phd">PhD:</span> {fam.phdProgram ? <a href={`${base}programs/${fam.phdProgram.slug}/`}>{fam.phd.inst}</a> : fam.phd.inst}{fam.phd.year ? `, ${fam.phd.year}` : ''}</div>}
      <div class="toolbar" style="margin-top:12px">
        <button type="button" class="btn save-btn" data-save={f.id} data-i18n="save">Save</button>
        {f.profile && <a class="btn" href={f.profile} target="_blank" rel="noreferrer" data-i18n="profile">Department profile</a>}
        {f.site && <a class="btn" href={f.site} target="_blank" rel="noreferrer" data-i18n="personal_site">Personal site</a>}
        {oa && <a class="btn" href={`https://openalex.org/authors/${oa}`} target="_blank" rel="noreferrer" data-i18n="oa_link">Publications (OpenAlex)</a>}
        {f.scholar && <a class="btn" href={f.scholar} target="_blank" rel="noreferrer" data-i18n="scholar">Google Scholar</a>}
      </div>
    </div>
  </div>
  <div class="fgrid">
    <div>
      {f.summary && <p class="lede" style="font-size:1.1rem"><span data-lang-only="en">{f.summary}</span><span data-lang-only="zh">{f.summary_zh || f.summary}</span></p>}
      {f.areas.length > 0 && <section style="margin-top:22px"><h2 class="sec-h" data-i18n="research_areas">Research areas (from the department)</h2><div class="chips" style="margin-top:8px">{f.areas.map((a) => <span class="chip">{a}</span>)}</div></section>}
      {rel.length > 0 && <section class="related">
        <h2 class="sec-h" data-i18n="related_h">Similar research</h2>
        <p class="small muted" data-i18n="related_lede">Faculty at any university whose research profile is closest to this one.</p>
        <ul class="rel-list">{rel.map((r) => (
          <li><a href={`${base}faculty/${r.f.id}/`}>{r.f.name}</a> <span class="muted">· {r.p?.short || r.f.u}</span>
            {r.shared.length > 0 && <div class="small muted"><span data-i18n="related_both">Both:</span> {r.shared.slice(0, 3).map((c, k) => <>{k > 0 && ' · '}<span data-lang-only="en">{T.dimensions.topic.labels_short[c]}</span><span data-lang-only="zh">{T.dimensions.topic.labels_short_zh[c]}</span></>)}</div>}
          </li>))}
        </ul>
        <p class="small" style="margin-top:10px"><a href={`${base}network/?p=${f.id}`} data-i18n="related_map">See on the network map</a> →</p>
      </section>}
      {fam && (fam.advisors.length + fam.students.length + fam.siblings.length) > 0 && <section class="related">
        <h2 class="sec-h" data-i18n="tree_h">Academic tree</h2>
        <p class="small muted" data-i18n="tree_lede">PhD advisors, PhD students, and faculty on this site who share an advisor. From Academic Family Tree, department profiles and Wikidata, so it may be incomplete.</p>
        <div class="tree-grid">
          {fam.advisors.length > 0 && <div><h3 class="tree-h" data-i18n="fam_advisor">PhD advisor</h3><ul class="tree-list">{fam.advisors.map((a) => <li>{'f' in a && a.f ? <><a href={`${base}faculty/${a.f.id}/`}>{a.f.name}</a> <span class="muted">· {a.p?.short || a.f.u}</span></> : <>{(a as any).name}{' '}<span class="small muted">· <span data-i18n="fam_not_listed">not on this site</span></span></>}</li>)}</ul></div>}
          {fam.students.length > 0 && <div><h3 class="tree-h" data-i18n="tree_students">PhD students</h3><ul class="tree-list">{fam.students.slice().sort((a, b) => Number('f' in b && !!b.f) - Number('f' in a && !!a.f)).slice(0, 12).map((a) => <li>{'f' in a && a.f ? <><a href={`${base}faculty/${a.f.id}/`}>{a.f.name}</a> <span class="muted">· {a.p?.short || a.f.u}</span></> : <>{(a as any).name}{' '}<span class="small muted">· <span data-i18n="fam_not_listed">not on this site</span></span></>}</li>)}</ul>{fam.students.length > 12 && <p class="small muted" style="margin-top:6px"><span data-lang-only="en">and {fam.students.length - 12} more</span><span data-lang-only="zh">另有 {fam.students.length - 12} 位</span></p>}</div>}
          {fam.siblings.length > 0 && <div><h3 class="tree-h" data-i18n="tree_siblings">Share an advisor</h3><ul class="tree-list">{fam.siblings.map((c) => <li><a href={`${base}faculty/${c.f.id}/`}>{c.f.name}</a> <span class="muted">· {c.p?.short || c.f.u}</span><div class="small muted"><span data-i18n="tree_via">Advisor:</span> {c.via}</div></li>)}</ul></div>}
        </div>
        <p class="small" style="margin-top:10px"><a href={`${base}network/?p=${f.id}&lines=adv`} data-i18n="tree_map">See the academic tree on the network map</a> →</p>
      </section>}
      {co.length > 0 && <section class="related">
        <h2 class="sec-h" data-i18n="co_h">Has published with</h2>
        <p class="small muted" data-i18n="co_lede">Faculty on this site who share papers with this person, from OpenAlex.</p>
        <ul class="rel-list">{co.slice(0, 12).map((c) => (
          <li><a href={`${base}faculty/${c.f.id}/`}>{c.f.name}</a> <span class="muted">· {c.p?.short || c.f.u}</span>
            <div class="small muted"><span data-lang-only="en">{c.n} {c.n === 1 ? 'paper' : 'papers'}{c.y ? `, latest ${c.y}` : ''}</span><span data-lang-only="zh">{c.n} 篇合著{c.y ? `，最近 ${c.y}` : ''}</span></div>
            {c.t && <div class="small muted co-title" title={c.t}>“{c.t}”</div>}
          </li>))}
        </ul>
        {co.length > 12 && <p class="small muted" style="margin-top:8px"><span data-lang-only="en">and {co.length - 12} more</span><span data-lang-only="zh">另有 {co.length - 12} 位</span></p>}
        <p class="small" style="margin-top:10px"><a href={`${base}network/?p=${f.id}&lines=co`} data-i18n="co_map">See co-authors on the network map</a> →</p>
      </section>}
    </div>
    <aside class="panel" style="align-self:start">
      <h2 class="sec-h" data-i18n="labels_title">Research labels</h2>
      {DIMS.map((d) => (f.labels[d] || []).length > 0 && (
        <div style="margin-top:12px"><div class="small" style="font-weight:600;margin-bottom:6px"><span data-lang-only="en">{T.dimensions[d].label}</span><span data-lang-only="zh">{T.dimensions[d].label_zh}</span></div>
          <div class="chips">{(f.labels[d] || []).map((l) => <span class={`chip${l.p ? ' primary' : ''}`} data-dim={d} title={T.dimensions[d].labels[l.c]}><span data-lang-only="en">{T.dimensions[d].labels_short[l.c]}</span><span data-lang-only="zh">{T.dimensions[d].labels_short_zh[l.c]}</span>{l.p ? ' ★' : ''}</span>)}</div></div>
      ))}
      <p class="small muted" style="margin-top:14px" data-i18n="labels_note">Labels are generated automatically from public profiles and may be incomplete. ★ marks a main focus.</p>
      <p class="small" style="margin-top:12px"><a href={issue} target="_blank" rel="noreferrer" data-i18n="report">Report an error</a></p>
    </aside>
  </div>
  <style is:global>
    .fgrid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 28px; margin-top: 26px; align-items: start; }
    @media (max-width: 860px) { .fgrid { grid-template-columns: 1fr; } }
    .related { margin-top: 28px; }
    .rel-list { list-style: none; margin: 10px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px 20px; }
    .rel-list a { font-weight: 600; color: var(--ink); text-decoration: none; }
    .rel-list a:hover { color: var(--action-text); }
    .tree-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px 24px; margin-top: 12px; }
    .tree-h { font-size: 0.8125rem; font-weight: 600; color: var(--ink-3); margin: 0 0 6px; }
    .tree-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
    .tree-list a { font-weight: 600; color: var(--ink); text-decoration: none; }
    .tree-list a:hover { color: var(--action-text); }
    .co-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-style: italic; margin-top: 2px; }
  </style>
  <script>
    import { bindSaveButtons } from '../../lib/ui';
    import { has } from '../../lib/shortlist';
    import { t } from '../../lib/i18n';
    document.querySelectorAll<HTMLButtonElement>('.save-btn').forEach((b) => { const on = has(b.dataset.save!); b.setAttribute('aria-pressed', String(on)); b.textContent = on ? t('saved') : t('save'); });
    bindSaveButtons(document);
  </script>
</Base>
