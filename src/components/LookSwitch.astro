---
// Temporary: lets you try the candidate designs on every page. Remove once one is chosen.
---
<div class="look-switch" role="group" aria-label="Preview design">
  <span>Preview design</span>
  <button type="button" data-look-btn="">Current</button>
  <button type="button" data-look-btn="journal">1 · Journal</button>
  <button type="button" data-look-btn="spectro">4 · Spectrogram</button>
  <button type="button" data-look-btn="gloss">5 · Gloss</button>
</div>
<script>
  const root = document.documentElement;
  const mark = () => document.querySelectorAll<HTMLButtonElement>('[data-look-btn]').forEach((b) => b.setAttribute('aria-pressed', String((root.dataset.look || '') === b.dataset.lookBtn)));
  document.querySelectorAll<HTMLButtonElement>('[data-look-btn]').forEach((b) => b.addEventListener('click', () => {
    const v = b.dataset.lookBtn || '';
    if (v) { root.dataset.look = v; root.dataset.theme = 'light'; } else { delete root.dataset.look; }
    try { v ? localStorage.setItem('look', v) : localStorage.removeItem('look'); } catch {}
    mark();
    document.dispatchEvent(new CustomEvent('themechange', { detail: 'light' }));
  }));
  mark();
</script>
