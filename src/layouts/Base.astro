---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/noto-sans/500.css';
import '../styles/global.css';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/theme.css';
import Header from '../components/Header.astro';
import buildInfo from '../data/meta.json';
import { SITE_NAME, OWNER, REPO_URL, SIBLING } from '../lib/site';
interface Props { title?: string; description?: string; wide?: boolean }
const { title = SITE_NAME, description = 'Find US Linguistics PhD programs and faculty whose research matches yours, across theoretical, experimental, computational, applied and field linguistics. Matching runs in your browser.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(`${base}og.png`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <script is:inline>
      (function () { try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; var l = localStorage.getItem('lang'); if (l === 'zh') document.documentElement.lang = 'zh'; try { localStorage.removeItem('look'); } catch (e) {} } catch (e) {} })();
    </script>
  </head>
  <body>
    <Header />
    <main class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        <span><span data-i18n="footer_by">Made by</span> <a href={OWNER.url} rel="noreferrer">{OWNER.name}</a></span>
        <span><a href={`${base}about/`} data-i18n="footer_about">How it works</a> · <a href={REPO_URL} rel="noreferrer" data-i18n="footer_source">Source code</a></span>
      </div>
    </footer>
  </body>
</html>
